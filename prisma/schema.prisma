generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  PHARMACY
  PHARMACY_OWNER
  PHARMACIST
  INSURANCE
  GOVERNMENT
  ADMIN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COLLECTED
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  COMPLETED
  MISSED
}

enum NotificationType {
  IN_APP
  SMS
  VOICE
}

enum PharmacyStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  phone             String              @unique
  password          String
  firstName         String
  lastName          String
  role              UserRole
  position          String?
  permissions       String[]            @default([])
  firstLogin        Boolean             @default(false)
  isActive          Boolean             @default(true)
  emailVerified     Boolean             @default(true)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  refreshTokens     RefreshToken[]
  patient           Patient?
  pharmacies        Pharmacy[]
  pharmacyOwner     PharmacyOwner?
  pharmacyEmployees PharmacyEmployee[]
  pharmacistPrescriptions Prescription[]
  insuranceProvider InsuranceProvider?
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([emailVerificationTokenHash])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Patient {
  id               String        @id @default(uuid())
  userId           String        @unique
  medicalProfile   String?
  address          String?
  dateOfBirth      DateTime?
  gender           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  prescriptions    Prescription[]
  insuredPolicies  InsuredPatient[]
  insuranceClaims  InsuranceClaim[]
  reminderSchedules ReminderSchedule[]
  reminderLogs     ReminderLog[]

  @@index([userId])
}

model Pharmacy {
  id             String           @id @default(uuid())
  ownerId        String
  name           String
  address        String
  latitude       Decimal?
  longitude      Decimal?
  phone          String
  licenseNumber  String?
  district       String?
  province       String?
  managerName    String?
  licenseUrl     String?
  status         PharmacyStatus   @default(PENDING)
  isActive       Boolean          @default(true)
  category       String?
  ownershipType  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerLink      PharmacyOwner?
  employees      PharmacyEmployee[]
  inventories    Inventory[]
  reservations   Reservation[]
  prescriptions  Prescription[]
  insuranceAgreements PharmacyInsuranceAgreement[]
  insuranceClaims     InsuranceClaim[]
  auditLogs      AuditLog[]

  @@index([ownerId])
  @@index([status])
  @@index([latitude, longitude])
}

model PharmacyOwner {
  id         String   @id @default(uuid())
  userId     String   @unique
  pharmacyId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pharmacyId])
}

model PharmacyEmployee {
  id         String   @id @default(uuid())
  pharmacyId String
  userId     String
  role       UserRole
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@index([userId])
  @@unique([pharmacyId, userId])
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique

  medicines Medicine[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Manufacturer {
  id        String     @id @default(uuid())
  name      String     @unique

  medicines Medicine[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Medicine {
  id             String       @id @default(uuid())

  tradeName      String
  genericName    String

  categoryId     String
  manufacturerId String

  category       Category     @relation(fields: [categoryId], references: [id])
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  batches        MedicineBatch[]
  inventories    Inventory[]
  reservations   Reservation[]
  prescriptionMedicines PrescriptionMedicine[]
  reminderSchedules ReminderSchedule[]
  insuranceTariffs InsuranceMedicineTariff[]
  insuranceClaims InsuranceClaim[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tradeName])
  @@index([genericName])
  @@index([categoryId])
  @@index([manufacturerId])
}

model MedicineBatch {
  id               String   @id @default(uuid())

  medicineId       String
  batchNumber      String
  lotNumber        String
  expiryDate       DateTime

  unitCost         Decimal  @db.Decimal(12, 2)
  unitSellingPrice Decimal  @db.Decimal(12, 2)

  initialStock     Int
  currentStock     Int

  storageConditions String?
  minTemperature   Decimal? @db.Decimal(5, 2)
  maxTemperature   Decimal? @db.Decimal(5, 2)

  medicine         Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([medicineId])
  @@index([expiryDate])
  @@unique([medicineId, batchNumber])
  @@unique([medicineId, lotNumber])
}

model Inventory {
  id               String            @id @default(uuid())
  pharmacyId       String
  medicineId       String
  quantity         Int               @default(0)
  price            Decimal
  expiryDate       DateTime?
  batchNumber      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  pharmacy         Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine         Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  inventoryHistory InventoryHistory[]
  stockMovements   StockMovement[]

  @@unique([pharmacyId, medicineId])
  @@index([pharmacyId])
  @@index([medicineId])
  @@index([expiryDate])
}

model InventoryHistory {
  id          String   @id @default(uuid())
  inventoryId String
  oldQuantity Int
  newQuantity Int
  oldPrice    Decimal?
  newPrice    Decimal?
  changedBy   String?
  changedAt   DateTime @default(now())

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([changedAt])
}

model StockMovement {
  id          String   @id @default(uuid())
  inventoryId String
  type        String
  quantity    Int
  reason      String?
  movedBy     String?
  movedAt     DateTime @default(now())

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([movedAt])
}

model Reservation {
  id          String            @id @default(uuid())
  patientId   String
  pharmacyId  String
  medicineId  String
  quantity    Int
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy    Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine    Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  insuranceClaims InsuranceClaim[]

  @@index([patientId])
  @@index([pharmacyId])
  @@index([medicineId])
  @@index([status])
  @@index([expiresAt])
}

model Prescription {
  id               String                 @id @default(uuid())
  patientId        String
  pharmacyId       String?
  pharmacistId     String?
  documentUrl      String?
  status           PrescriptionStatus     @default(PENDING)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  patient          Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy         Pharmacy?              @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  pharmacist       User?                  @relation(fields: [pharmacistId], references: [id], onDelete: SetNull)
  medicines        PrescriptionMedicine[]
  reminderSchedules ReminderSchedule[]
  insuranceClaims  InsuranceClaim[]

  @@index([patientId])
  @@index([pharmacyId])
  @@index([status])
}

model PrescriptionMedicine {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineId     String
  dosage         String
  frequency      String
  duration       String
  quantity       Int

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       Medicine     @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([medicineId])
}

model ReminderSchedule {
  id            String           @id @default(uuid())
  patientId     String
  prescriptionId String?
  medicineId    String
  dosage        String
  startDate     DateTime
  endDate       DateTime
  timeOfDay     String[]
  intervalHours Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription  Prescription?    @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  medicine      Medicine         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  logs          ReminderLog[]

  @@index([patientId])
  @@index([prescriptionId])
  @@index([startDate, endDate])
}

model ReminderLog {
  id         String         @id @default(uuid())
  scheduleId String
  patientId  String
  type       NotificationType
  status     ReminderStatus
  sentAt     DateTime?
  error      String?
  createdAt  DateTime       @default(now())

  schedule   ReminderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  patient    Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  pharmacyId  String?
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pharmacyId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ── INSURANCE MODELS ─────────────────────────────────────────────────────────

model InsuranceProvider {
  id                        String                       @id @default(uuid())
  userId                    String?                      @unique
  name                      String                       @unique
  code                      String                       @unique
  logoUrl                   String?
  email                     String?
  phone                     String?
  address                   String?
  defaultCoveragePercentage Decimal                      @default(85.00) @db.Decimal(5, 2)
  defaultCopayPercentage    Decimal                      @default(15.00) @db.Decimal(5, 2)
  status                    String                       @default("ACTIVE")
  isActive                  Boolean                      @default(true)
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  user                      User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  insuredPatients           InsuredPatient[]
  pharmacyAgreements        PharmacyInsuranceAgreement[]
  tariffs                   InsuranceMedicineTariff[]
  claims                    InsuranceClaim[]

  @@index([code])
  @@index([status])
}

model InsuredPatient {
  id                    String            @id @default(uuid())
  insuranceId           String
  patientId             String?
  policyNumber          String            @unique
  nationalId            String?
  fullName              String
  dateOfBirth           DateTime?
  gender                String?
  phone                 String?
  coveragePercentage    Decimal?          @db.Decimal(5, 2)
  status                String            @default("ACTIVE")
  startDate             DateTime          @default(now())
  endDate               DateTime?
  dependentName         String?
  dependentRelationship String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  insurance             InsuranceProvider @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  patient               Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  claims                InsuranceClaim[]

  @@index([insuranceId])
  @@index([patientId])
  @@index([policyNumber])
  @@index([nationalId])
  @@index([status])
}

model PharmacyInsuranceAgreement {
  id                 String            @id @default(uuid())
  insuranceId        String
  pharmacyId         String
  contractNumber     String?
  status             String            @default("ACTIVE")
  discountRate       Decimal           @default(0.00) @db.Decimal(5, 2)
  customCoverageRate Decimal?          @db.Decimal(5, 2)
  startDate          DateTime          @default(now())
  endDate            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  insurance          InsuranceProvider @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  pharmacy           Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([insuranceId, pharmacyId])
  @@index([insuranceId])
  @@index([pharmacyId])
  @@index([status])
}

model InsuranceMedicineTariff {
  id                 String            @id @default(uuid())
  insuranceId        String
  medicineId         String
  coveredPrice       Decimal           @db.Decimal(12, 2)
  coveragePercentage Decimal           @default(85.00) @db.Decimal(5, 2)
  copayPercentage    Decimal           @default(15.00) @db.Decimal(5, 2)
  fixedCopayAmount   Decimal?          @db.Decimal(12, 2)
  isCovered          Boolean           @default(true)
  requiresPreAuth    Boolean           @default(false)
  status             String            @default("ACTIVE")
  effectiveDate      DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  insurance          InsuranceProvider @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  medicine           Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([insuranceId, medicineId])
  @@index([insuranceId])
  @@index([medicineId])
  @@index([status])
}

model InsuranceClaim {
  id               String            @id @default(uuid())
  claimNumber      String            @unique
  insuranceId      String
  pharmacyId       String
  insuredPatientId String?
  patientId        String?
  medicineId       String?
  prescriptionId   String?
  reservationId    String?
  quantity         Int               @default(1)
  unitPrice        Decimal           @db.Decimal(12, 2)
  totalAmount      Decimal           @db.Decimal(12, 2)
  insuranceAmount  Decimal           @db.Decimal(12, 2)
  patientAmount    Decimal           @db.Decimal(12, 2)
  status           String            @default("PENDING")
  rejectionReason  String?
  notes            String?
  claimedAt        DateTime          @default(now())
  processedAt      DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  insurance        InsuranceProvider @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  pharmacy         Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  insuredPatient   InsuredPatient?   @relation(fields: [insuredPatientId], references: [id], onDelete: SetNull)
  patient          Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  medicine         Medicine?         @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  prescription     Prescription?     @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  reservation      Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([claimNumber])
  @@index([insuranceId])
  @@index([pharmacyId])
  @@index([status])
  @@index([claimedAt])
}

