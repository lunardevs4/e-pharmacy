NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/database
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Use none for HTTPS frontends hosted on a different site than the API.
COOKIE_SAME_SITE=lax
PORT=3000

# Redis is required in production for shared rate-limit state.
# Leave unset for local in-memory development, or use redis://localhost:6379.
REDIS_URL=redis://localhost:6379

# NestJS throttling (milliseconds for TTL values)
THROTTLE_GLOBAL_LIMIT=1000
THROTTLE_GLOBAL_TTL_MS=60000
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_REGISTRATION_LIMIT=3
THROTTLE_REGISTRATION_TTL_MS=60000
THROTTLE_PASSWORD_LIMIT=3
THROTTLE_PASSWORD_TTL_MS=900000
THROTTLE_MEDICINE_SEARCH_LIMIT=60
THROTTLE_MEDICINE_SEARCH_TTL_MS=60000
THROTTLE_USER_SENSITIVE_LIMIT=20
THROTTLE_USER_SENSITIVE_TTL_MS=60000

# SMS / voice / TTS provider configuration
SMS_PROVIDER_MODE=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=
SMS_MAX_RETRIES=3

VOICE_PROVIDER_MODE=mock
VOICE_API_KEY=
VOICE_API_SECRET=
VOICE_MAX_RETRIES=2

TTS_PROVIDER_MODE=mock
TTS_API_KEY=
TTS_API_SECRET=
TTS_LANGUAGE=rw
TTS_VOICE=

# Monitoring / observability
MONITORING_PROVIDER=mock
MONITORING_API_KEY=

# Configure these together when email delivery is enabled.
GMAIL_USER=
GMAIL_APP_PASSWORD=
